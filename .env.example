
ANTHROPIC_API_KEY=your-anthropic-key-here


OPENAI_API_KEY=your-openai-key-here


ENVIRONMENT=development


DATA_DIR=../data
RAW_HTML_DIR=../data/raw/html
PROCESSED_DIR=../data/processed
EMBEDDINGS_DIR=../data/embeddings



ADMIN_TOKEN=your-admin-token-here

# Stripe donations (Bowen Public Charitable Trust account).
# Use sk_test_/whsec_ from the test-mode dashboard locally; sk_live_ in production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: public site URL for Checkout redirects (defaults to request Origin)
FRONTEND_URL=https://bowenpublic.com

# Comma-separated allowed browser origins in production
ALLOWED_ORIGINS=https://bowenpublic.com,https://www.bowenpublic.com
