
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional: Claude model for /chat and /chat/stream (default claude-opus-5-5),
# e.g. claude-sonnet-5-5. Leave unset to use the default.
BOWEN_CLAUDE_MODEL=
# Search planner (backend/app/planner.py): a Claude Haiku call that adds an Act's sections and a reworded search; on unless set to off.
BOWEN_PLANNER=
# Planner model (default claude-haiku-5-5). Leave unset to use the default.
BOWEN_PLANNER_MODEL=


OPENAI_API_KEY=your-openai-key-here
# Second opinion (backend/app/second_opinion.py): an OpenAI model checks Claude's
# answer against the excerpts. off | shadow (log only) | enforce (append a caution line).
# Default: shadow when OPENAI_API_KEY is set, off otherwise. Leave the rest unset for defaults.
BOWEN_SECOND_OPINION=
# Default gpt-6.1-sol; reasoning effort default low; timeout default 8 (seconds).
BOWEN_SECOND_OPINION_MODEL=
BOWEN_SECOND_OPINION_EFFORT=
BOWEN_SECOND_OPINION_TIMEOUT=

# Web context (backend/app/web_context.py): a web search adds a separate, labelled
# "From the web" block. off | gap (only when the answer has a gap) | always.
# Default: gap when the chosen provider's key is set, off otherwise.
# Provider: openai (OpenAI web search, uses OPENAI_API_KEY above) | perplexity.
# Default: openai when OPENAI_API_KEY is set, else perplexity when PERPLEXITY_API_KEY is set.
BOWEN_WEB_CONTEXT_PROVIDER=
PERPLEXITY_API_KEY=
BOWEN_WEB_CONTEXT=
# Model default gpt-6.1-sol (openai) or perplexity/sonar (perplexity);
# timeout default 20 (openai) or 12 (perplexity) seconds.
BOWEN_WEB_CONTEXT_MODEL=
BOWEN_WEB_CONTEXT_TIMEOUT=
# Comma-separated search allowlist (max 100 openai, 20 perplexity). Unset = NZ official sites; "none" = whole web.
BOWEN_WEB_CONTEXT_DOMAINS=


ENVIRONMENT=development


DATA_DIR=../data
RAW_HTML_DIR=../data/raw/html
PROCESSED_DIR=../data/processed
EMBEDDINGS_DIR=../data/embeddings



ADMIN_TOKEN=your-admin-token-here

# Stripe donations (Bowen Public Charitable Trust account).
# Use sk_test_/whsec_ from the test-mode dashboard locally; sk_live_ in production.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Optional: public site URL for Checkout redirects (defaults to request Origin)
FRONTEND_URL=https://bowenpublic.com

# Comma-separated allowed browser origins in production
ALLOWED_ORIGINS=https://bowenpublic.com,https://www.bowenpublic.com
